#!/usr/bin/env python3
"""Link the skills listed in linked-skills.txt into a skills directory."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SKILLS_LIST = REPO_ROOT / "linked-skills.txt"
DEFAULT_DEST = Path("~/.claude/skills")
PI_SETTINGS = Path("~/.pi/agent/settings.json")
# Pi scans both recursively; a same-named copy there is a name collision.
PI_SKILL_DIRS = (Path("~/.agents/skills"), Path("~/.pi/agent/skills"))


def listed_skills(path: Path) -> list[str]:
    names = []
    for line in path.read_text(encoding="utf-8").splitlines():
        name = line.split("#", 1)[0].strip()
        if name:
            names.append(name)
    return names


def pi_package_registered(settings_path: Path) -> bool | None:
    """Whether pi's settings list this repo as a package; None when there is no settings file."""
    if not settings_path.is_file():
        return None
    settings = json.loads(settings_path.read_text(encoding="utf-8"))
    for entry in settings.get("packages", []):
        source = entry.get("source") if isinstance(entry, dict) else entry
        if not isinstance(source, str) or source.startswith(("npm:", "git:", "http")):
            continue
        # Pi resolves a relative package path against the settings file's directory.
        resolved = (settings_path.parent / Path(source).expanduser()).resolve()
        if resolved == REPO_ROOT.resolve():
            return True
    return False


def pi_collisions(names: list[str], scan_dirs: list[Path]) -> list[str]:
    """Curated names that exist in a pi-scanned dir as something other than a link to the repo.

    Pi skips a second path to the same real file silently, so a symlink into the repo is
    fine; a copy is a different file and gets a collision warning.
    """
    found = []
    for scan_dir in scan_dirs:
        for name in names:
            entry = scan_dir / name
            if not (entry.is_symlink() or entry.exists()):
                continue
            source = REPO_ROOT / ".agents" / "skills" / name
            if Path(os.path.realpath(entry)) != Path(os.path.realpath(source)):
                found.append(f"duplicate {name}: {entry} is not a link to {source}")
    return found


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Symlink the curated skills into a skills directory."
    )
    parser.add_argument(
        "--dest",
        type=Path,
        default=DEFAULT_DEST,
        help="skills directory to link into (default: ~/.claude/skills)",
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="report actions without making them"
    )
    parser.add_argument(
        "--check", action="store_true", help="exit 1 if anything would change"
    )
    args = parser.parse_args(argv)

    read_only = args.dry_run or args.check
    dest = args.dest.expanduser()
    if not read_only:
        dest.mkdir(parents=True, exist_ok=True)

    would_change = False
    conflict = False

    for name in listed_skills(SKILLS_LIST):
        source = REPO_ROOT / ".agents" / "skills" / name
        target = dest / name

        if not source.is_dir():
            print(f"skip {name}: not written yet")
            continue

        if target.is_symlink():
            if Path(os.path.realpath(target)) == Path(os.path.realpath(source)):
                print(f"ok {name}")
                continue
            would_change = True
            verb = "would relink" if read_only else "relink"
            print(f"{verb} {name}: {os.readlink(target)} -> {source}")
            if not read_only:
                target.unlink()
                target.symlink_to(source)
            continue

        if target.exists():
            conflict = True
            kind = "directory" if target.is_dir() else "file"
            print(f"conflict {name}: real {kind} at {target}")
            continue

        would_change = True
        verb = "would link" if read_only else "link"
        print(f"{verb} {name}: {target} -> {source}")
        if not read_only:
            target.symlink_to(source)

    names = listed_skills(SKILLS_LIST)
    pi_problem = False
    registered = pi_package_registered(PI_SETTINGS.expanduser())
    if registered is None:
        pi_problem = True
        print(
            f"missing pi settings: create {PI_SETTINGS} containing "
            + json.dumps({"packages": [str(REPO_ROOT)]})
        )
    elif registered:
        print("ok pi package")
    else:
        pi_problem = True
        print(f'missing pi package: add "{REPO_ROOT}" to packages in {PI_SETTINGS}')
    scan_dirs = [d.expanduser() for d in PI_SKILL_DIRS]
    for line in pi_collisions(names, scan_dirs):
        pi_problem = True
        print(line)

    if conflict or pi_problem:
        return 1
    if args.check and would_change:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
