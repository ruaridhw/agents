#!/usr/bin/env python3
"""Link the skills listed in linked-skills.txt into a skills directory."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SKILLS_LIST = REPO_ROOT / "linked-skills.txt"
DEFAULT_DEST = Path("~/.claude/skills")


def listed_skills(path: Path) -> list[str]:
    names = []
    for line in path.read_text(encoding="utf-8").splitlines():
        name = line.split("#", 1)[0].strip()
        if name:
            names.append(name)
    return names


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Symlink the curated skills into a skills directory."
    )
    parser.add_argument(
        "--dest",
        type=Path,
        default=DEFAULT_DEST,
        help="skills directory to link into (default: ~/.claude/skills)",
    )
    parser.add_argument(
        "--dry-run", action="store_true", help="report actions without making them"
    )
    parser.add_argument(
        "--check", action="store_true", help="exit 1 if anything would change"
    )
    args = parser.parse_args(argv)

    read_only = args.dry_run or args.check
    dest = args.dest.expanduser()
    if not read_only:
        dest.mkdir(parents=True, exist_ok=True)

    would_change = False
    conflict = False

    for name in listed_skills(SKILLS_LIST):
        source = REPO_ROOT / ".claude" / "skills" / name
        target = dest / name

        if not source.is_dir():
            print(f"skip {name}: not written yet")
            continue

        if target.is_symlink():
            if Path(os.path.realpath(target)) == Path(os.path.realpath(source)):
                print(f"ok {name}")
                continue
            would_change = True
            verb = "would relink" if read_only else "relink"
            print(f"{verb} {name}: {os.readlink(target)} -> {source}")
            if not read_only:
                target.unlink()
                target.symlink_to(source)
            continue

        if target.exists():
            conflict = True
            kind = "directory" if target.is_dir() else "file"
            print(f"conflict {name}: real {kind} at {target}")
            continue

        would_change = True
        verb = "would link" if read_only else "link"
        print(f"{verb} {name}: {target} -> {source}")
        if not read_only:
            target.symlink_to(source)

    if conflict:
        return 1
    if args.check and would_change:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
