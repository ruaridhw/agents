#!/usr/bin/env python3
"""Fail when a file meant for this public repo names something private.

The rules are regexes kept outside the repo: the content of PUBLIC_DENYLIST_RULES
when that variable is set (CI supplies it from a repository secret), else the file
named by PUBLIC_DENYLIST (default ~/.config/agents/public-denylist.txt).
Missing or empty rules are an error: the check fails closed.

Usage: check-public [--all] [FILE...]
  FILE...  check these files (what pre-commit passes)
  --all    check every tracked file instead of the public-facing scope
  (none)   check the public-facing scope: skills, conventions, harness files
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

DEFAULT_RULES = Path.home() / ".config" / "agents" / "public-denylist.txt"
SCOPE = (
    ".claude/skills/",
    "conventions/",
    "hooks/",
    ".pi/",
    "bin/",
    "LANDSCAPE.md",
    "FEEDS.md",
    "UPSTREAMS.json",
    "linked-skills.txt",
    "package.json",
)


def load_rules(path: Path) -> list[re.Pattern[str]]:
    content = os.environ.get("PUBLIC_DENYLIST_RULES")
    if content is not None:
        return parse_rules(content, "PUBLIC_DENYLIST_RULES")
    if not path.is_file():
        raise SystemExit(f"check-public: rules file missing: {path} (failing closed)")
    return parse_rules(path.read_text(), str(path))


def parse_rules(text: str, source: str) -> list[re.Pattern[str]]:
    rules = []
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            rules.append(re.compile(line, re.IGNORECASE))
        except re.error as exc:
            raise SystemExit(f"check-public: bad rule at {source}:{number}: {exc}")
    if not rules:
        raise SystemExit(f"check-public: no rules in {source} (failing closed)")
    return rules


def repo_files(root: Path, everything: bool) -> list[Path]:
    out = subprocess.run(
        ["git", "ls-files", "-co", "--exclude-standard"],
        cwd=root,
        capture_output=True,
        text=True,
        check=True,
    ).stdout.splitlines()
    if not everything:
        out = [f for f in out if f.startswith(SCOPE)]
    return [root / f for f in out]


def scan(path: Path, rules: list[re.Pattern[str]]) -> list[str]:
    try:
        data = path.read_bytes()
    except (FileNotFoundError, IsADirectoryError):
        return []
    if b"\0" in data:
        return []
    hits = []
    for number, line in enumerate(data.decode("utf-8", "replace").splitlines(), 1):
        for rule in rules:
            if rule.search(line):
                hits.append(f"{path}:{number}: matches /{rule.pattern}/")
    return hits


def main(argv: list[str]) -> int:
    everything = "--all" in argv
    files = [Path(a) for a in argv if a != "--all"]
    rules = load_rules(Path(os.environ.get("PUBLIC_DENYLIST", DEFAULT_RULES)))
    if not files:
        root = Path(__file__).resolve().parent.parent
        files = repo_files(root, everything)
    hits = [hit for f in files for hit in scan(f, rules)]
    for hit in hits:
        print(hit)
    if hits:
        print(f"check-public: {len(hits)} private reference(s) found", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
