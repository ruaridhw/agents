#!/usr/bin/env python3
"""Fail when a curated skill's SKILL.md front matter breaks the house rules.

Rules, for every .agents/skills/*/SKILL.md:
  - the file starts with a --- fence, and the block between the fences is a
    YAML mapping
  - name: present, lowercase-hyphen, at most 64 characters, equal to the
    directory name
  - description: present, non-empty, at most 1024 characters
  - no two skills share a name
  - upstream, when present, is a list whose entries each carry repo, path, sha

Usage: check-skill-frontmatter [--root DIR]
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parent))

import skill_upstream  # noqa: E402

NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
NAME_MAX = 64
DESCRIPTION_MAX = 1024
FEED_FIELDS = ("repo", "path", "sha")


def front_matter(path: Path) -> tuple[str | None, str | None]:
    """The text between the fences, or (None, why not) when there is none."""
    text = path.read_text(encoding="utf-8")
    info = skill_upstream.parse_skill(text)
    if info is None or info["start"] != 0:
        return None, "no front matter: the file must start with a --- fence"
    block = "".join(info["lines"][info["start"] + 1 : info["end"]])
    return block, None


def check_fields(skill_md: Path, label: str, problems: list[str]) -> str | None:
    """Check one skill's front matter; return its name when it has a usable one."""
    block, error = front_matter(skill_md)
    if error is not None:
        problems.append(f"{label}: {error}")
        return None
    try:
        data = yaml.safe_load(block)
    except yaml.YAMLError as exc:
        detail = " ".join(str(exc).split())
        problems.append(f"{label}: front matter is not valid YAML: {detail}")
        return None
    if not isinstance(data, dict):
        problems.append(f"{label}: front matter is not a YAML mapping")
        return None

    name = data.get("name")
    if not isinstance(name, str) or not name.strip():
        problems.append(f"{label}: missing name")
        name = None
    else:
        if not NAME_RE.match(name):
            problems.append(f"{label}: name {name!r} is not lowercase-hyphen")
        if len(name) > NAME_MAX:
            problems.append(f"{label}: name is longer than {NAME_MAX} characters")
        if name != skill_md.parent.name:
            problems.append(
                f"{label}: name {name!r} does not match directory"
                f" {skill_md.parent.name!r}"
            )

    description = data.get("description")
    if not isinstance(description, str) or not description.strip():
        problems.append(f"{label}: missing description")
    elif len(description) > DESCRIPTION_MAX:
        problems.append(
            f"{label}: description is longer than {DESCRIPTION_MAX} characters"
        )

    if "upstream" in data:
        entries = data["upstream"]
        if not isinstance(entries, list):
            problems.append(f"{label}: upstream is not a list")
        else:
            for number, entry in enumerate(entries, 1):
                if not isinstance(entry, dict):
                    problems.append(
                        f"{label}: upstream entry {number} is not a mapping"
                    )
                    continue
                for field in FEED_FIELDS:
                    value = entry.get(field)
                    if not isinstance(value, str) or not value.strip():
                        problems.append(
                            f"{label}: upstream entry {number} missing {field}"
                        )
    return name


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="check-skill-frontmatter",
        description="Validate the front matter of every curated SKILL.md.",
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=Path(__file__).resolve().parent.parent,
        help="repository root holding .agents/skills (default: this checkout)",
    )
    args = parser.parse_args(argv)

    problems: list[str] = []
    owners: dict[str, list[str]] = {}
    for skill_md in sorted((args.root / skill_upstream.SKILLS_DIR).glob("*/SKILL.md")):
        label = f"{skill_upstream.SKILLS_DIR}/{skill_md.parent.name}/SKILL.md"
        name = check_fields(skill_md, label, problems)
        if name is not None:
            owners.setdefault(name, []).append(label)
    for name, labels in sorted(owners.items()):
        if len(labels) > 1:
            problems.append(f"{name}: duplicate skill name in {', '.join(labels)}")

    for problem in problems:
        print(problem)
    if problems:
        print(
            f"check-skill-frontmatter: {len(problems)} problem(s) in SKILL.md"
            " front matter",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
