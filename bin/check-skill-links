#!/usr/bin/env python3
"""Check that every skill in linked-skills.txt is visible to Claude Code and pi.

Read-only: it reports and exits 1, and never links, relinks or deletes. Linking itself
is the host's job (a sync job, or the one-liner in README.md).
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SKILLS_LIST = REPO_ROOT / "linked-skills.txt"
DEFAULT_DEST = Path("~/.claude/skills")
PI_SETTINGS = Path("~/.pi/agent/settings.json")
# Pi scans both recursively; a same-named copy there is a name collision.
PI_SKILL_DIRS = (Path("~/.agents/skills"), Path("~/.pi/agent/skills"))


def listed_skills(path: Path) -> list[str]:
    names = []
    for line in path.read_text(encoding="utf-8").splitlines():
        name = line.split("#", 1)[0].strip()
        if name:
            names.append(name)
    return names


def pi_package_registered(settings_path: Path) -> bool | None:
    """Whether pi's settings list this repo as a package; None when there is no settings file."""
    if not settings_path.is_file():
        return None
    settings = json.loads(settings_path.read_text(encoding="utf-8"))
    for entry in settings.get("packages", []):
        source = entry.get("source") if isinstance(entry, dict) else entry
        if not isinstance(source, str) or source.startswith(("npm:", "git:", "http")):
            continue
        # Pi resolves a relative package path against the settings file's directory.
        resolved = (settings_path.parent / Path(source).expanduser()).resolve()
        if resolved == REPO_ROOT.resolve():
            return True
    return False


def pi_collisions(names: list[str], scan_dirs: list[Path]) -> list[str]:
    """Curated names that exist in a pi-scanned dir as something other than a link to the repo.

    Pi skips a second path to the same real file silently, so a symlink into the repo is
    fine; a copy is a different file and gets a collision warning.
    """
    found = []
    for scan_dir in scan_dirs:
        for name in names:
            entry = scan_dir / name
            if not (entry.is_symlink() or entry.exists()):
                continue
            source = REPO_ROOT / ".agents" / "skills" / name
            if Path(os.path.realpath(entry)) != Path(os.path.realpath(source)):
                found.append(f"duplicate {name}: {entry} is not a link to {source}")
    return found


def claude_links(names: list[str], dest: Path) -> list[str]:
    """Problems with the per-skill links Claude Code reads from `dest`."""
    problems = []
    for name in names:
        source = REPO_ROOT / ".agents" / "skills" / name
        target = dest / name
        if not source.is_dir():
            print(f"skip {name}: not written yet")
            continue
        if not (target.is_symlink() or target.exists()):
            problems.append(f"missing {name}: ln -s {source} {target}")
        elif Path(os.path.realpath(target)) == Path(os.path.realpath(source)):
            print(f"ok {name}")
        else:
            problems.append(f"conflict {name}: {target} is not a link to {source}")
    return problems


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--dest",
        type=Path,
        default=DEFAULT_DEST,
        help="Claude Code skills directory to check (default: ~/.claude/skills)",
    )
    args = parser.parse_args(argv)

    names = listed_skills(SKILLS_LIST)
    problems = claude_links(names, args.dest.expanduser())

    registered = pi_package_registered(PI_SETTINGS.expanduser())
    if registered is None:
        problems.append(
            f"missing pi settings: create {PI_SETTINGS} containing "
            + json.dumps({"packages": [str(REPO_ROOT)]})
        )
    elif registered:
        print("ok pi package")
    else:
        problems.append(
            f'missing pi package: add "{REPO_ROOT}" to packages in {PI_SETTINGS}'
        )
    problems += pi_collisions(names, [d.expanduser() for d in PI_SKILL_DIRS])

    for problem in problems:
        print(problem)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
