#!/usr/bin/env python3
"""Render LANDSCAPE.md as docs/landscape.html, a self-contained page.

The landscape is the record of every curated skill: the opinion behind it,
its upstream feeds, and what was taken and dropped from each. This page is
the shareable form of that record. Run `bin/render-landscape` after editing
LANDSCAPE.md; `--check` exits 1 when the committed page is stale.
"""

from __future__ import annotations

import html
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "LANDSCAPE.md"
TARGET = ROOT / "docs" / "landscape.html"
STYLE = ROOT / "docs" / "landscape.css"


def inline(text: str) -> str:
    text = html.escape(text, quote=False)
    text = re.sub(r"`([^`]+)`", r"<code>\1</code>", text)
    text = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", text)
    text = re.sub(r"(?<![\w*])\*([^*\n]+)\*(?!\w)", r"<i>\1</i>", text)
    return text


def slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def render(markdown: str) -> tuple[str, list[tuple[str, str, int]]]:
    out: list[str] = []
    toc: list[tuple[str, str, int]] = []
    lines = markdown.split("\n")
    i = 0
    in_list: str | None = None
    section_open = False

    def close_list() -> None:
        nonlocal in_list
        if in_list:
            out.append(f"</{in_list}>")
            in_list = None

    while i < len(lines):
        line = lines[i]
        if line.startswith("# "):
            i += 1
            continue
        if line.startswith("```"):
            close_list()
            buf = []
            i += 1
            while i < len(lines) and not lines[i].startswith("```"):
                buf.append(lines[i])
                i += 1
            i += 1
            out.append(
                "<pre><code>%s</code></pre>" % html.escape("\n".join(buf), quote=False)
            )
            continue
        if line.startswith("## "):
            close_list()
            if section_open:
                out.append("</section>")
            text = line[3:]
            sid = slug(text)
            toc.append((sid, text, 2))
            out.append(f'<section id="{sid}"><h2>{inline(text)}</h2>')
            section_open = True
            i += 1
            continue
        if line.startswith("### "):
            close_list()
            text = line[4:]
            sid = slug(text)
            toc.append((sid, text, 3))
            out.append(f'<h3 id="{sid}">{inline(text)}</h3>')
            i += 1
            continue
        if line.startswith("|"):
            close_list()
            rows = []
            while i < len(lines) and lines[i].startswith("|"):
                rows.append([c.strip() for c in lines[i].strip().strip("|").split("|")])
                i += 1
            header, body = (
                rows[0],
                [r for r in rows[1:] if not set("".join(r)) <= set("-: ")],
            )
            out.append(
                '<div class="tablewrap"><table><thead><tr>'
                + "".join(f"<th>{inline(h)}</th>" for h in header)
                + "</tr></thead><tbody>"
            )
            for row in body:
                out.append(
                    "<tr>" + "".join(f"<td>{inline(c)}</td>" for c in row) + "</tr>"
                )
            out.append("</tbody></table></div>")
            continue
        if re.match(r"^\d+\. ", line):
            if in_list != "ol":
                close_list()
                out.append("<ol>")
                in_list = "ol"
            item = re.sub(r"^\d+\. ", "", line)
            out.append(f"<li>{inline(item)}</li>")
            i += 1
            continue
        if line.startswith("- "):
            if in_list != "ul":
                close_list()
                out.append("<ul>")
                in_list = "ul"
            out.append(f"<li>{inline(line[2:])}</li>")
            i += 1
            continue
        if not line.strip():
            i += 1
            continue
        close_list()
        out.append(f"<p>{inline(line)}</p>")
        i += 1
    close_list()
    if section_open:
        out.append("</section>")
    return "\n".join(out), toc


def page(body: str, toc: list[tuple[str, str, int]]) -> str:
    nav = "".join(
        f'<li class="l{level}"><a href="#{sid}">{html.escape(text)}</a></li>'
        for sid, text, level in toc
    )
    skills = sum(1 for _, _, level in toc if level == 2) - 2
    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Skills landscape</title>
<meta name="description" content="The opinions and decisions behind every curated skill: what each is for, which upstream skills feed it, and what was taken and dropped.">
<link rel="stylesheet" href="landscape.css">
</head>
<body>
<button class="themebtn" type="button" id="theme" aria-label="Toggle colour theme">Theme</button>
<div class="layout">
<nav class="toc" aria-label="Sections"><ol>{nav}</ol></nav>
<main>
<header class="hero">
<p class="eyebrow">ruaridhw/agents · generated from LANDSCAPE.md</p>
<h1>The skills landscape</h1>
<p class="lede">One opinionated set of skills, curated from mattpocock/skills, obra/superpowers and poteto's pstack. For every curated skill: the opinion behind it, the upstream files that feed it, and what was taken and what was dropped from each, so the loss is never silent and upstream changes can be diffed in later.</p>
<div class="meta"><span><b>Curated skills</b> {skills}</span><span><b>Source of truth</b> LANDSCAPE.md</span></div>
</header>
{body}
</main>
</div>
<script>
(function(){{
  var b=document.getElementById('theme'),r=document.documentElement;
  function cur(){{return r.getAttribute('data-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}}
  b.addEventListener('click',function(){{r.setAttribute('data-theme',cur()==='dark'?'light':'dark')}});
}})();
</script>
</body>
</html>
"""


def main(argv: list[str]) -> int:
    body, toc = render(SOURCE.read_text())
    rendered = page(body, toc)
    if "--check" in argv:
        if not TARGET.is_file() or TARGET.read_text() != rendered:
            print(
                "render-landscape: docs/landscape.html is stale; run bin/render-landscape"
            )
            return 1
        return 0
    TARGET.write_text(rendered)
    print(f"wrote {TARGET.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
